gem "liquid", "~> 4.0", ">= 4.0.4"
gem "kramdown-parser-gfm"

# Libraries packaged separately by current Ruby versions.
gem "csv"
gem "logger"
gem "bigdecimal"
gem "base64"
gem "webrick", "~> 1.8"

group :jekyll_plugins do
  gem "jekyll-paginate"
  gem "jekyll-gist"
  gem "jekyll-feed"
  gem "jekyll-sitemap"
  gem "jekyll-redirect-from"
end
